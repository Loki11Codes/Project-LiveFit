generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  accounts       Account[]
  measurements   BodyMeasurement[]
  chatMessages   ChatMessage[]
  dayTypeEntries DayTypeEntry[]
  foodLogs       FoodLog[]
  goals          Goal?
  sessions       Session[]
  sleepLogs      SleepLog[]
  profile        UserProfile?
  workoutLogs    WorkoutLog[]
  routines       Routine[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodLog {
  id      String   @id @default(cuid())
  userId  String
  name    String
  protein Float
  kcal    Float
  carbs   Float?
  fats    Float?
  fiber   Float?
  time    DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  focus     String
  volume    Float?
  details   String?
  time      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  routineId String?
  routine   Routine? @relation(fields: [routineId], references: [id])
  exercises WorkoutExercise[]
}

model SleepLog {
  id       String   @id @default(cuid())
  userId   String
  hours    Float
  bedTime  String?
  wakeTime String?
  time     DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  id      String   @id @default(cuid())
  userId  String
  weight  Float?
  waist   Float?
  chest   Float?
  arms    Float?
  thighs  Float?
  hips    Float?
  time    DateTime @default(now())
  bodyFat Float?
  calves  Float?
  neck    Float?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id              String @id @default(cuid())
  userId          String @unique
  proteinTarget   Float
  kcalTarget      Float
  proteinLite     Float?
  proteinRest     Float?
  proteinTraining Float?
  sleepTarget     Float?
  waterTarget     Float?
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  age         Int?
  gender      String?
  height      Float?
  startDay    Int?
  primaryGoal String?
  day1        String?
  day2        String?
  day3        String?
  day4        String?
  day5        String?
  day6        String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DayTypeEntry {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  dayType   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  text      String
  createdAt DateTime @default(now())
  images    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id               String   @id @default(cuid())
  name             String   @unique
  category         String   // e.g. "Chest", "Cardio"
  equipment        String?  // e.g. "Dumbbell", "Barbell"
  
  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  exercises   RoutineExercise[]
  workoutLogs WorkoutLog[]
}

model RoutineExercise {
  id         String   @id @default(cuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  customName String? // Fallback if Exercise not in master DB
  order      Int
  targetSets Int
  targetReps String?
}

model WorkoutExercise {
  id           String   @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId   String?
  exercise     Exercise? @relation(fields: [exerciseId], references: [id])
  customName   String?
  order        Int
  
  sets         WorkoutSet[]
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  reps              Int?
  weight            Float?
  distance          Float?   // km/miles
  duration          Int?     // seconds
  isWarmup          Boolean  @default(false)
  isDrop            Boolean  @default(false)
  isFailure         Boolean  @default(false)
}
