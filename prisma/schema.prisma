// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  
  // App specific data
  foodLogs         FoodLog[]
  workoutLogs      WorkoutLog[]
  sleepLogs        SleepLog[]
  measurements     BodyMeasurement[]
  dayTypeEntries   DayTypeEntry[]
  goals            Goal?
  profile          UserProfile?
  chatMessages     ChatMessage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  name      String
  protein   Float
  kcal      Float
  carbs     Float?
  fats      Float?
  fiber     Float?
  time      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id        String   @id @default(cuid())
  userId    String
  focus     String
  volume    Float?
  details   String?  // JSON string or long text
  time      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  hours     Float
  bedTime   String?
  wakeTime  String?
  time      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  weight    Float?
  waist     Float?
  chest     Float?
  arms      Float?
  thighs    Float?
  hips      Float?
  calves    Float?
  neck      Float?
  bodyFat   Float?
  time      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id              String @id @default(cuid())
  userId          String @unique
  proteinTarget   Float
  kcalTarget      Float
  proteinTraining Float?
  proteinRest     Float?
  proteinLite     Float?
  waterTarget     Float?
  sleepTarget     Float?
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  age         Int?
  gender      String?
  height      Float?
  startDay    Int?
  primaryGoal String?
  day1        String?
  day2        String?
  day3        String?
  day4        String?
  day5        String?
  day6        String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DayTypeEntry {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  dayType   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" or "model"
  text      String
  images    String?  // JSON serialized array of ChatImageAttachment payload if provided
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
